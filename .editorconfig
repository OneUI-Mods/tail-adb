root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.gradle.kts]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf

[{gradlew,gradlew.bat}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[third_party/**]
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
